# --- Anthropic (chat brain for website chat + WhatsApp) ---
ANTHROPIC_API_KEY=

# --- Supabase (storage + admin auth) ---
# Required in production. Run supabase/schema.sql first. Without these, local dev
# uses .data/db.json and the admin desk is open.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated emails allowed into /admin (on top of emails on the Team page)
ADMIN_EMAILS=

# --- WhatsApp (choose one path) ---
# Path A · Meta Cloud API (recommended for cost)
META_WA_ACCESS_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_VERIFY_TOKEN=
# App secret from Meta App Dashboard → Settings → Basic; verifies X-Hub-Signature-256
META_APP_SECRET=
# Path B · Twilio (recommended for reliability)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio signatures are checked against NEXT_PUBLIC_APP_URL — set it to the exact public origin
TWILIO_WHATSAPP_NUMBER=

# --- Email marketing (Resend) ---
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. "ProxyTech <offers@mail.yourdomain.co.uk>"
EMAIL_FROM=
# Long random string; signs unsubscribe links. Changing it breaks links in already-sent emails.
UNSUBSCRIBE_SECRET=
# From Resend → Webhooks (whsec_...); endpoint: /api/email/webhook, events: email.bounced, email.complained
RESEND_WEBHOOK_SECRET=
# Random string; Vercel Cron sends it as a Bearer token to /api/cron/email (daily campaign top-up)
CRON_SECRET=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
